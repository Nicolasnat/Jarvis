[Unit]
Description=Jarvis - assistente de voz local
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@PROJETO@
ExecStartPre=@PROJETO@/ajustar_microfone.sh
ExecStart=@PROJETO@/venv/bin/python @PROJETO@/jarvis.py --servico
Restart=on-failure
RestartSec=5
# Prioridade mais baixa: em segundo plano nao atrapalha o uso normal.
Nice=5

[Install]
WantedBy=default.target
