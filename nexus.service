[Unit]
Description=Nexus - assistente de voz local
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@PROJETO@
# Servicos systemd --user nao herdam DISPLAY/XAUTHORITY da sessao grafica, e sem
# eles a interface Qt nao abre (o Nexus cai no modo terminal sem avisar direito).
# O ExecStartPre copia o ambiente do gerenciador para um arquivo, e o
# ExecStart le esse arquivo logo antes de comecar (EnvironmentFile e relido a
# cada execucao). Sem esse par, so a voz funciona.
ExecStartPre=/usr/bin/mkdir -p @PROJETO@/dados
ExecStartPre=/bin/sh -c 'systemctl --user show-environment > @PROJETO@/dados/nexus-env.conf'
EnvironmentFile=-@PROJETO@/dados/nexus-env.conf
ExecStartPre=/bin/sh -c 'until curl -sf http://127.0.0.1:11434 >/dev/null; do sleep 2; done'
ExecStartPre=@PROJETO@/ajustar_microfone.sh
ExecStart=@PROJETO@/venv/bin/python @PROJETO@/nexus.py --interface --servico
Restart=on-failure
RestartSec=5
# Prioridade mais baixa: em segundo plano nao atrapalha o uso normal.
Nice=5

[Install]
# Sobe junto com a sessao grafica: e ela que define DISPLAY/XAUTHORITY.
WantedBy=graphical-session.target
